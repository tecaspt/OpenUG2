# Host-test binaries (tests/host/build/) and any other in-tree build dir.
build/
# Build products. PARAM.SFO alone is not enough: the bench target names its SFO
# bench.sfo (see runtime/bench/Makefile), so match the extension.
*.sfo
*.SFO
# The PSP Makefiles emit a default $(TARGET).conf alongside the SFO (game.conf,
# bench.conf, replay.conf). No .conf is tracked, so ignore the extension.
*.conf
/dist/
__pycache__/
